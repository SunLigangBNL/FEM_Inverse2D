<?
import sys
import os

MODULES_DIR = "/home/sun2024/Gitspace/FEM_Inverse2D/forward_model/modules"
if MODULES_DIR not in sys.path:
    sys.path.insert(0, MODULES_DIR)

import construct_poly

cdp, scatp, subp = construct_poly.polygons(keys)
keys["compdomain_points"] = cdp
keys["scatterer_points"] = scatp
keys["substrate_points"] = subp
?>

Layout2D {
  Name = "RoundedGrating"
  UnitOfLength = 1e-9
  MeshOptions {
    MaximumSideLength = %(msl)e
  }
  BoundaryConditions {
    Boundary {
      Class = Periodic
      Direction = [X, -X]
    }
    Boundary {
      Class = Transparent
      Direction = [Y, -Y]
    }
  }
  Objects {
    Polygon {
      Name = "ComputationalDomain"
      Points = %(compdomain_points)e
      Priority = -1
      DomainId = 1
    }
    Polygon {
      Name = "ScattererDomain"
      Points = %(scatterer_points)e
      Priority = 1
      DomainId = 2
      CornerRounding {
        Point = 4
        Radius = %(r_bot)e
        NPoints = %(rad_lower_n)d
      }
      CornerRounding {
        Point = 5
        Radius = %(r_top)e
        NPoints = %(rad_upper_n)d
      }
      CornerRounding {
        Point = 6
        Radius = %(r_top)e
        NPoints = %(rad_upper_n)d
      }
      CornerRounding {
        Point = 7
        Radius = %(r_bot)e
        NPoints = %(rad_lower_n)d
      }
    }
    Polygon {
      Name = "SubstrateDomain"
      Points = %(substrate_points)e
      Priority = 2
      DomainId = 3
    }
  }
}
