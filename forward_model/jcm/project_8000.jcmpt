Project {
  InfoLevel = 3
  Electromagnetics {
    TimeHarmonic {
      Scattering {
        FieldComponents = Electric
        Accuracy {
          Precision = 1e-1
          PrecisionFarField = 1e-1
          FiniteElementDegree = 5
          Refinement {
            MaxNumberSteps = 6
          }
        }
      }
    }
  }
}
PostProcess {
  ExportFields {
    FieldBagPath = "project_results/fieldbag.jcm"
    OutputQuantity = "ElectricFieldStrength"
    OutputFileName = "project_results/nearfield.jcm"
    Cartesian {
      GridPointsX = [-10e-9 : 4e-9 : 10e-9]
      GridPointsY = [0e-9 : 2e-9 : 10e-9]
      GridPointsZ = 0
    }
  }
}
PostProcess {  
  FourierTransform {  
    FieldBagPath = "project_results/fieldbag.jcm"  
    OutputFileName = "project_results/fourier_modes_plus_y.jcm" 
    NormalDirection = Y  
    NumericalAperture = 1
  }  
}
PostProcess {
  FourierTransform {
    FieldBagPath = "project_results/fieldbag.jcm"
    OutputFileName = "project_results/fourier_modes_minus_y.jcm"
    NormalDirection = -Y
    NumericalAperture = %(numerical_aperture)e
  }
}
